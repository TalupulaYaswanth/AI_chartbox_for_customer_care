# Optional Twilio Credentials for Production Phone Calls
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ZEGOCLOUD Real-Time Voice Call / RTC SDK Configuration
# Obtain AppID and ServerSecret from https://console.zegocloud.com/
ZEGO_APP_ID=123456789
ZEGO_SERVER_SECRET=0123456789abcdef0123456789abcdef
ZEGO_APP_SIGN=
ZEGO_TOKEN_EXPIRY=3600

# App Configuration
FLASK_PORT=5000
SECRET_KEY=dev-secret-key-change-in-production
